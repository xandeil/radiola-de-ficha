# Copie para .env e ajuste.
# true  = usa os dados falsos (mock) salvos no localStorage
# false = chama o back-end real em VITE_API_URL
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8000/api

# Spotify (Fase 2). Sem isto, o app usa um catálogo de DEMONSTRAÇÃO.
# Crie um app em https://developer.spotify.com/dashboard e cadastre o Redirect URI:
#   http://127.0.0.1:5173/callback/spotify   (o Spotify não aceita "localhost")
VITE_SPOTIFY_CLIENT_ID=

# Mercado Pago (Fase 4). Sem isto, o checkout usa um formulário de cartão SIMULADO.
# Use a PUBLIC KEY de teste do painel (https://www.mercadopago.com.br/developers/panel).
# NUNCA coloque o Access Token aqui: ele é segredo e fica só no back-end PHP.
VITE_MP_PUBLIC_KEY=

# Deezer (Fase 6). OPCIONAL: sem isto, "Conectar" já liga busca + prévias de 30 s.
# Com um App ID (https://developers.deezer.com/myapps) o usuário entra com a conta dele.
# Redirect: http://localhost:5173/callback/deezer
VITE_DEEZER_APP_ID=

# Apple Music (Fase 6). OPCIONAL: sem isto, usa a iTunes Search API (busca + prévias de 30 s).
# Para tocar a faixa inteira (MusicKit JS), aponte para um endpoint do SEU back-end que
# devolva { "token": "<developer token JWT>" }. A chave .p8 da Apple NUNCA vem para o front.
VITE_APPLE_MUSIC_TOKEN_URL=
# Loja (país) do catálogo Apple: br, us, es...
VITE_APPLE_MUSIC_STOREFRONT=br
